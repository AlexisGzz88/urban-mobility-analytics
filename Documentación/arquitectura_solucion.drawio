        <mxCell id="107" value="DataProfiler: detecta anomalías → genera silver_rules.yml automáticamente&#xa;Señales: '$45.00' → clean_currency | dupes → deduplicate | mixed dates → normalize_date_format&#xa;inverted ts → fix_timestamp_order | pct &gt; 100 → clamp | null PKs → quarantine_nulls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
