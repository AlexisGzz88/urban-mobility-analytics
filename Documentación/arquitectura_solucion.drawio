        <mxCell id="106" value="44 clases de transformación:&#xa;CleanCurrency · NormalizeValues&#xa;NormalizeDateFormat · Deduplicate&#xa;AddDerivedColumn · ClampNumeric&#xa;ValidateEnum · FixTimestampOrder&#xa;DetectImpossibleCombination&#xa;ValidateDateRange · AddAuditColumns&#xa;QuarantineNulls + más..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
